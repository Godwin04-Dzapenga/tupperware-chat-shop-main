# Supabase — authentication and application data
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Medusa v2 — public Store API
# Example local URL: http://localhost:9000
VITE_MEDUSA_BACKEND_URL=
VITE_MEDUSA_PUBLISHABLE_KEY=
VITE_MEDUSA_REGION_ID=
# Required when using the Medusa cart provider.
VITE_MEDUSA_CURRENCY_CODE=usd

# "medusa" is the target commerce catalogue provider.
# Use "supabase" only during the migration/bootstrap stage.
VITE_COMMERCE_CATALOG_PROVIDER=medusa
